# Copy to .env (gitignored) and fill in. Read by the API on startup.

# Sign-in (Supabase). Both values are public: Settings -> API Keys in the
# Supabase dashboard. Never put the secret / service_role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: generated support messages for High stress.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Optional: where saved scores live (default data/app/safespace.db).
# SAFESPACE_DB=
