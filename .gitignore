# Local Python environments
/safespace/
.venv/
venv/
env/

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Model artifacts
# Keep the small Python loader modules in Git, but host trained weights and
# generated model files outside normal Git. See safespace_fusion/README.md.
safespace_fusion/models/*.h5
safespace_fusion/models/*.keras
safespace_fusion/models/*.npz
safespace_fusion/models/*.npy
safespace_fusion/models/*.pkl
safespace_fusion/models/*.safetensors
safespace_fusion/models/.cache/
safespace_fusion/models/features/
safespace_fusion/models/stress_classifier_epoch2/
safespace_fusion/models/models_face/resnet50_features/
safespace_fusion/models/models_face/vit_features/

# Downloaded datasets (fetched by scripts, never committed) - repo root only,
# so it does not also hide the src/safespace/data package.
/data/

# Model weights (fetched or trained, never committed)
/artifacts/

# Unpublished paper draft
Technical_paper*.pdf

# Python cache and build output
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Environment / secrets
.env
.env.*

# macOS
.DS_Store
